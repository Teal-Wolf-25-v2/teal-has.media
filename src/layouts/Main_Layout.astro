---
const { title } = Astro.props;
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
---
<html>
<head>
    <link rel="icon" href="/images/logo.png">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Teal Wolf 25">
    <meta name="application-name" content="About Me">
    <meta name="description" content="The website for Teal Wolf 25 where you can find faer content.">
    <meta name="url" content="https://www.teal-has.media">
    <meta property="og:image" content="https://www.teal-has.media/images/a_drink_to_remember_smol.png" />
    <meta name="theme-color" content="#007f7f">
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
</head>
<body>
    <Navigation />
    <slot />
</body>
</html>

<style>
    html,body {
        background-image: url("/images/website_bg.png");
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        margin: 0;
        /* Ugly fix for vertical scrollbar on Chromium Based Browsers */
        overflow-x: hidden;
    }

    @media (prefers-color-scheme: light) {
        html,body {
            background-image: url("/images/website_bg_light.png");
        }
    }
</style>