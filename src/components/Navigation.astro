---
import { Image } from 'astro:assets';
import Hamburger from './Hamburger.astro';

const links = [
    { label: 'Home', href: '/' },
    { label: 'Shop', href: 'https://shop.teal-has.media', external: true },
];
---

<Hamburger
        class="nav-menu"
        links={links}
        panelTop="pt-20 max-md:portrait:pt-48"
>
    <a slot="brand" href="/" class="logo-link flex items-center gap-3">
        <Image
                src="/images/logo.png"
                alt="Teal Wolf 25 logo: a teal wolf in a purple witch hat, waving one hand with a glowing spark of magic."
                width={150}
                height={150}
                class="logo size-12.5"
                loading="eager"
        />
        <h3 class="text-teal-75 light:text-teal-25">Teal Wolf 25</h3>
    </a>
</Hamburger>